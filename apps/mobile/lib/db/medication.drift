-- `AS MedicationCourseRow` avoids colliding with model/medication.dart's
-- MedicationCourse (the domain model) — see person.drift for the pattern.
CREATE TABLE medication_course (
    id TEXT NOT NULL PRIMARY KEY,
    person_id TEXT NOT NULL REFERENCES person(id),
    medication_name TEXT NOT NULL,
    status TEXT NOT NULL,
    start_date TEXT NOT NULL,
    end_date TEXT,
    prescriber_name TEXT,
    reason TEXT
) AS MedicationCourseRow;

-- `AS SchedulePhaseRow` avoids colliding with model/schedule_phase.dart's
-- SchedulePhase (the domain model) — see person.drift for the pattern.
-- is_prn stays INTEGER (not BOOLEAN) to match the raw SQL in
-- specs/phase-1-v1/02-architecture.md §4 exactly; the repository layer does
-- the int<->bool conversion, same as every other row->model mapping here.
CREATE TABLE schedule_phase (
    id TEXT NOT NULL PRIMARY KEY,
    course_id TEXT NOT NULL REFERENCES medication_course(id),
    dose_amount TEXT NOT NULL,
    frequency INTEGER NOT NULL,
    period INTEGER NOT NULL,
    period_unit TEXT NOT NULL,
    days_of_week TEXT,
    times_of_day TEXT NOT NULL,
    is_prn INTEGER NOT NULL DEFAULT 0,
    prn_reason TEXT,
    prn_max_frequency TEXT,
    phase_start TEXT NOT NULL,
    phase_end TEXT,
    -- Reserved for phase 2's sync conflict rule; always NULL in phase 1
    -- since single-device usage has no conflicts to represent yet. See
    -- specs/phase-1-v1/02-architecture.md §6's conflict rule —
    -- activeNonConflictedPhasesForPerson() must already respect this column.
    conflict_group_id TEXT
) AS SchedulePhaseRow;

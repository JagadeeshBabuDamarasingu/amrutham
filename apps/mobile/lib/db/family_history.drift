-- `AS FamilyHistoryEntryRow` avoids colliding with
-- model/family_history.dart's FamilyHistoryEntry (the domain model) — see
-- person.drift for the pattern and the `.drift`-file-vs-Dart-annotation note.
CREATE TABLE family_history_entry (
    id TEXT NOT NULL PRIMARY KEY,
    person_id TEXT NOT NULL REFERENCES person(id),
    relationship TEXT NOT NULL,
    condition_text TEXT NOT NULL,
    condition_code TEXT,
    onset_age_approx INTEGER,
    outcome TEXT,
    certainty TEXT NOT NULL,
    notes TEXT
) AS FamilyHistoryEntryRow;

<?xml version="1.0" encoding="utf-8"?>
<!-- The 5 x 1 dial bar: icon, then the contact and whose it is. Only view types a
     widget may inflate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/amrutham_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/amrutham_widget_dial_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="8dp"
    android:paddingEnd="16dp"
    android:paddingStart="16dp"
    android:paddingTop="8dp">

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@null"
        android:src="@drawable/amrutham_ic_phone"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/amrutham_dial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Dial"
            android:textColor="#2A1D00"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/amrutham_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#4A3300"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/amrutham_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#2A1D00"
            android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>

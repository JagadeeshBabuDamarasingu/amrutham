<?xml version="1.0" encoding="utf-8"?>
<!-- One big dial button. Only view types a widget may inflate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/amrutham_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/amrutham_widget_dial_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:src="@drawable/amrutham_ic_phone"/>

    <TextView
        android:id="@+id/amrutham_dial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Dial"
        android:textColor="#2A1D00"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/amrutham_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#4A3300"
        android:textSize="13sp"/>

    <TextView
        android:id="@+id/amrutham_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#2A1D00"
        android:textSize="13sp"/>
</LinearLayout>

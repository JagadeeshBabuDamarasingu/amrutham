<?xml version="1.0" encoding="utf-8"?>
<!-- Blood group and allergies for a glance. Only view types a widget may inflate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/amrutham_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/amrutham_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/amrutham_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#9FC0B2"
        android:textSize="12sp"
        android:textStyle="bold"/>

    <LinearLayout
        android:id="@+id/amrutham_blood_tile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/amrutham_widget_tile"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="6dp"
        android:paddingEnd="16dp"
        android:paddingStart="16dp"
        android:paddingTop="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BLOOD"
            android:textColor="#4A3300"
            android:textSize="10sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/amrutham_blood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#2A1D00"
            android:textSize="34sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:id="@+id/amrutham_blood_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#DCEBE4"
        android:textSize="13sp"/>

    <TextView
        android:id="@+id/amrutham_allergies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="#FFFFFF"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/amrutham_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#DCEBE4"
        android:textSize="13sp"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- The 5 x 2 card: details on the left, blood group and the dial button stacked
     on the right, so a wide card has no empty middle. Same ids as the other card
     layouts. Only view types a widget may inflate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/amrutham_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/amrutham_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="10dp"
    android:paddingEnd="12dp"
    android:paddingStart="16dp"
    android:paddingTop="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/amrutham_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/amrutham_widget_label"
            android:textAllCaps="true"
            android:textColor="#9FC0B2"
            android:textSize="10sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/amrutham_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/amrutham_blood_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#DCEBE4"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/amrutham_allergies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/amrutham_medicines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#DCEBE4"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/amrutham_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#DCEBE4"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/amrutham_blood_tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/amrutham_widget_tile"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="4dp"
            android:paddingEnd="14dp"
            android:paddingStart="14dp"
            android:paddingTop="4dp">

            <TextView
                android:id="@+id/amrutham_blood_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BLOOD"
                android:textColor="#4A3300"
                android:textSize="9sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/amrutham_blood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#2A1D00"
                android:textSize="28sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/amrutham_dial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/amrutham_widget_button"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingBottom="8dp"
            android:paddingEnd="12dp"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:textColor="#2A1D00"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>

# Where the site is served (used for canonical links, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://amrutham.app

# Google Play listing. The applicationId in apps/mobile is still the Flutter
# default (app.amrutham); Play will not accept that, so change it before
# publishing and update this link to match.
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.amrutham

# Optional. Shown on the privacy page when set.
NEXT_PUBLIC_CONTACT_EMAIL=

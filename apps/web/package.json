{
	"name": "@amrutham/web",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "next dev --turbopack --port 3000",
		"build": "next build --turbopack",
		"start": "next start --port 3000",
		"preview": "next build --turbopack && next start --port 3000",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css}\" --cache",
		"format:write": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css}\" --cache",
		"clean": "rm -rf .next .turbo"
	},
	"dependencies": {
		"next": "16.3.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.3.1",
		"prettier": "^3.5.3",
		"typescript": "^5"
	}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amrutham.app/backup-schema.json",
  "title": "Amrutham backup, schema 1.x (the JSON inside the encrypted envelope)",
  "type": "object",
  "required": [
    "people"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of this document"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Major number of schemaVersion; the only version key in files made before schemaVersion existed"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "relationship",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "givenName": {
            "type": [
              "string",
              "null"
            ]
          },
          "surname": {
            "type": [
              "string",
              "null"
            ]
          },
          "relationship": {
            "type": "string"
          },
          "dateOfBirth": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "sex": {
            "type": [
              "string",
              "null"
            ]
          },
          "bloodGroup": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "isDeceased": {
            "type": "boolean"
          },
          "dateOfDeath": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "causeOfDeath": {
            "type": [
              "string",
              "null"
            ]
          },
          "emergencyContacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "phone"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "phone": {
                  "type": "string"
                },
                "relationship": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "familyHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "personId",
          "relationship",
          "conditionText",
          "certainty"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "personId": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          },
          "conditionText": {
            "type": "string"
          },
          "conditionCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "onsetAgeApprox": {
            "type": [
              "integer",
              "null"
            ]
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ]
          },
          "certainty": {
            "type": "string"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "allergies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "personId",
          "substance",
          "reaction",
          "certainty"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "personId": {
            "type": "string"
          },
          "substance": {
            "type": "string"
          },
          "reaction": {
            "type": "string"
          },
          "severity": {
            "type": [
              "string",
              "null"
            ]
          },
          "certainty": {
            "type": "string"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "personId",
          "medicationName",
          "status",
          "startDate"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "personId": {
            "type": "string"
          },
          "medicationName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "prescriberName": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "courseId",
          "doseAmount",
          "frequency",
          "period",
          "periodUnit",
          "phaseStart"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "courseId": {
            "type": "string"
          },
          "doseAmount": {
            "type": "string"
          },
          "frequency": {
            "type": "integer"
          },
          "period": {
            "type": "integer"
          },
          "periodUnit": {
            "type": "string"
          },
          "daysOfWeek": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "timesOfDay": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-2][0-9]:[0-5][0-9]$"
            }
          },
          "isPrn": {
            "type": "boolean"
          },
          "prnReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "prnMaxFrequency": {
            "type": [
              "string",
              "null"
            ]
          },
          "phaseStart": {
            "type": "string",
            "format": "date-time"
          },
          "phaseEnd": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "conflictGroupId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "personId",
          "kind",
          "value",
          "measuredAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "personId": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "value2": {
            "type": [
              "number",
              "null"
            ]
          },
          "measuredAt": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "personId",
          "kind",
          "title",
          "eventDate"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "personId": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "eventDate": {
            "type": "string",
            "format": "date-time"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "doseLogs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "personId",
          "courseId",
          "scheduledAt",
          "status",
          "loggedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "personId": {
            "type": "string"
          },
          "courseId": {
            "type": "string"
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "loggedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "careTeam": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "isCurrent"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "doctor",
              "facility"
            ]
          },
          "name": {
            "type": "string"
          },
          "isCurrent": {
            "type": "boolean"
          },
          "specialty": {
            "type": [
              "string",
              "null"
            ]
          },
          "worksAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "personIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "expenses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "personId",
          "title",
          "amountPaise",
          "category",
          "spentOn",
          "addedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "personId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "amountPaise": {
            "type": "integer",
            "description": "Whole paise"
          },
          "category": {
            "type": "string"
          },
          "spentOn": {
            "type": "string",
            "format": "date-time"
          },
          "addedAt": {
            "type": "string",
            "format": "date-time"
          },
          "payee": {
            "type": [
              "string",
              "null"
            ]
          },
          "paidBy": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "personId",
          "type",
          "title",
          "recordDate",
          "addedAt",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "personId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "recordDate": {
            "type": "string",
            "format": "date-time"
          },
          "addedAt": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "data"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "data": {
                  "type": "string",
                  "contentEncoding": "base64"
                }
              }
            }
          }
        }
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "data"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "contentEncoding": "base64"
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "schemaVersion"
      ]
    },
    {
      "required": [
        "version"
      ]
    }
  ]
}
